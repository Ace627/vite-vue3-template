{
  "name": "vite-vue3-template",
  "version": "0.0.1",
  "private": true,
  "description": "本项目提供了一个基于 Vue3、TypeScript 和 Vite 的基础配置模板，适合快速启动项目或作为开发的起点。",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "clean:svg": "node --experimental-strip-types scripts/svg-clean.ts",
    "format": "oxfmt . --write",
    "format:check": "oxfmt . --check"
  },
  "dependencies": {
    "pinia": "^4.0.2",
    "vue": "^3.5.39",
    "vue-router": "^5.2.0"
  },
  "devDependencies": {
    "@types/node": "^24.13.2",
    "@vitejs/plugin-vue": "^6.0.7",
    "@vue/tsconfig": "^0.9.1",
    "oxfmt": "^0.59.0",
    "sass": "^1.101.0",
    "typescript": "~6.0.2",
    "unocss": "^66.7.5",
    "unplugin-auto-import": "^21.0.0",
    "unplugin-vue-components": "^32.1.0",
    "vite": "^8.1.1",
    "vite-plugin-svg-icons-ng": "^1.9.2",
    "vue-tsc": "^3.3.5"
  }
}
