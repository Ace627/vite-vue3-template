{
  "name": "vite-vue3-template",
  "version": "0.0.1",
  "private": true,
  "description": "本项目提供了一个基于 Vue3、TypeScript 和 Vite 的基础配置模板，适合快速启动项目或作为开发的起点。",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "clean:svg": "node --experimental-strip-types scripts/svg-clean.ts",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\""
  },
  "dependencies": {
    "axios": "^1.20.0",
    "dayjs": "^1.11.23",
    "echarts": "^6.1.0",
    "element-plus": "^2.14.5",
    "lodash-es": "^4.18.1",
    "pinia": "^4.0.3",
    "vue": "^3.5.42",
    "vue-router": "^5.3.0"
  },
  "devDependencies": {
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^26.4.0",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/tsconfig": "^0.9.1",
    "fast-glob": "^3.3.3",
    "prettier": "^3.9.6",
    "sass": "^1.103.1",
    "typescript": "~6.0.2",
    "unocss": "^66.8.1",
    "unplugin-auto-import": "^21.1.0",
    "unplugin-element-plus": "^0.11.2",
    "unplugin-vue-components": "^32.1.0",
    "vite": "^8.2.2",
    "vite-plugin-compression2": "^2.5.3",
    "vite-plugin-svg-icons": "^2.0.1",
    "vue-tsc": "^3.3.11"
  }
}
